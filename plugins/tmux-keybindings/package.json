{
  "name": "@oullin/herdr-tmux-keybindings",
  "version": "0.2.0",
  "description": "Apply a canonical tmux keymap and open a modal Herdr binding reference.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oullin/herdr-plugins.git",
    "directory": "plugins/tmux-keybindings"
  },
