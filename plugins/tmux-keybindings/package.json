    "#tmux-keybindings/infrastructure/*": "./src/infrastructure/*.ts",
    "#tmux-keybindings/presentation/*": "./src/presentation/*.ts",
    "#tmux-keybindings/testing/*": "./tests/*.ts"
  },
  "exports": "./index.ts",
  "dependencies": {
    "@oullin/herdr-plugin-core": "file:../../package/core"
  },
  "engines": {
    "node": ">=24.12.0 <25"
